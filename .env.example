# ── Avalanche Fuji ───────────────────────────────────────────────
# Dirección pública del contrato EvidenceRegistry desplegado en Fuji (chainId 43113).
# Si queda vacía, el MVP permite desplegarlo desde /estado con MetaMask/Core.
NEXT_PUBLIC_EVIDENCE_REGISTRY_ADDRESS=
# Opcional: explorador alternativo (por defecto https://testnet.snowtrace.io)
NEXT_PUBLIC_AVALANCHE_EXPLORER_URL=

# ── Oracle Cloud Infrastructure (solo servidor, nunca NEXT_PUBLIC_) ─
# Pre-Authenticated Request de bucket con permiso de lectura y escritura de objetos, con prefijo:
# https://objectstorage.<region>.oraclecloud.com/p/<token>/n/<namespace>/b/<bucket>/o/
OCI_OBJECT_STORAGE_PAR_URL=
